#!/usr/bin/env bash
# opencode-safe — `opencode` that cannot hang on a dead model endpoint.
#
# `opencode run` retries connect errors and 5xx forever. This wrapper probes the OpenAI base
# (the gateway's on the mini, IU's elsewhere) with `curl --max-time 5` first. Any HTTP response below 500 (401/404 included) counts
# as reachable; a connect error, the 5 s timeout or a 5xx does not.
# It puts NO wall-clock ceiling on opencode itself (an agentic run killed mid-work reads as a
# model failure); a probe that needs one sets OPENCODE_SAFE_TIMEOUT.
#
# Reads (first hit wins):
#   AGW_GATEWAY_URL   the inference gateway's origin (the mini) — probed at <url>/openai/v1
#   IU_OPENAI_BASE    an OpenAI base (…/openai/v1)
#   IU_BASE_URL       the Anthropic base (…/anthropic) — rewritten to …/openai/v1
#   Keychain item     `claude-sdk-base-url` (macOS `security`), same rewrite
# Tunables:
#   OPENCODE_SAFE_TIMEOUT   optional: seconds before opencode is killed (unset = no ceiling)
#
# Exit 75 (EX_TEMPFAIL) + one stderr line when the endpoint is unreachable; exit 78
# (EX_CONFIG) when the base cannot be resolved or curl/timeout is missing. Otherwise exits
# with opencode's own status (124 = OPENCODE_SAFE_TIMEOUT hit).
# Worker use: never run a bare `opencode run` as a probe — use `opencode-safe run …`.
set -euo pipefail

fail() {
  echo "opencode-safe: $1" >&2
  exit "${2:-75}"
}

derive_openai_base() {
  local raw="$1"
  if [[ "$raw" == */anthropic || "$raw" == */anthropic/ ]]; then
    raw="${raw%/}"
    echo "${raw%/anthropic}/openai/v1"
  else
    echo "$raw"
  fi
}

base=""
if [[ -n "${AGW_GATEWAY_URL:-}" ]]; then
  base="${AGW_GATEWAY_URL%/}/openai/v1"
fi
[[ -n "$base" ]] || base="${IU_OPENAI_BASE:-}"
if [[ -z "$base" && -n "${IU_BASE_URL:-}" ]]; then
  base="$(derive_openai_base "$IU_BASE_URL")"
fi
if [[ -z "$base" ]] && command -v security >/dev/null 2>&1; then
  raw="$(security find-generic-password -s claude-sdk-base-url -w 2>/dev/null || true)"
  [[ -n "$raw" ]] && base="$(derive_openai_base "$raw")"
fi
[[ -n "$base" ]] || fail "model base URL not resolvable (set AGW_GATEWAY_URL, IU_OPENAI_BASE or IU_BASE_URL) — not running opencode" 78

command -v curl >/dev/null 2>&1 || fail "curl not found on PATH — cannot probe the model endpoint" 78
code=$(curl --silent --output /dev/null --max-time 5 --write-out '%{http_code}' "$base" || true)
[[ $code =~ ^[1-4][0-9][0-9]$ ]] ||
  fail "model endpoint unreachable or failing (HTTP ${code:-none}) — not running opencode"

if [[ -z "${OPENCODE_SAFE_TIMEOUT:-}" ]]; then
  exec opencode "$@"
fi
if command -v timeout >/dev/null 2>&1; then
  tmo=timeout
elif command -v gtimeout >/dev/null 2>&1; then
  tmo=gtimeout
else
  fail "OPENCODE_SAFE_TIMEOUT set but no timeout/gtimeout binary on PATH" 78
fi

exec "$tmo" "$OPENCODE_SAFE_TIMEOUT" opencode "$@"
