<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jkrumm.agent-workflows-host</string>

  <!-- Never a Homebrew binary directly (macOS BTM disallows it): the zsh wrapper is the indirection. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__RELEASE_DIR__/scripts/launch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RELEASE_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>AGW_MACHINE</key>
    <string>mini</string>
    <key>AGW_PORT</key>
    <string>7791</string>
    <key>AGW_VERSION</key>
    <string>__SHA__</string>
    <!-- The image door's caller tokens (name=token, mode 0600): the file the audio process reads, one for both doors. -->
    <key>AGW_DOOR_CALLERS_FILE</key>
    <string>__DATA_DIR__/door-tokens</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A fail-closed launch (exit 78) retries at this pace, not in a tight loop. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- SIGTERM shutdown (runtime close, telemetry flush) must finish before SIGKILL; the host's own backstop is 45 s. -->
  <key>ExitTimeOut</key>
  <integer>120</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-workflows-host.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-workflows-host.err.log</string>
</dict>
</plist>
