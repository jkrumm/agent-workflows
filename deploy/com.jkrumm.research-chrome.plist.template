<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jkrumm.research-chrome</string>

  <!-- The headed Chrome web.fetch falls back to for pages that turn a plain HTTP client away (AGW_BROWSER_CDP_URL).
       Headed on purpose: a headless Chrome is flagged by bot walls. DevTools listens on loopback only; the profile
       is dedicated, so its cookies (a solved challenge) persist and nothing else shares them. Not part of a release:
       `make research-chrome` installs it. A Chrome already running on this profile makes this launch hand over and
       exit 0, which KeepAlive below does not restart; a crash or kill does. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9222</string>
    <string>--remote-debugging-address=127.0.0.1</string>
    <string>--user-data-dir=__HOME__/.local/share/research-chrome</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
    <string>about:blank</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/research-chrome.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/research-chrome.err.log</string>
</dict>
</plist>
